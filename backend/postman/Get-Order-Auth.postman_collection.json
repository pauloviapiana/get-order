        {
          "name": "Login cliente novo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('não expõe senha', () => pm.expect(pm.response.text()).to.not.include('\"senha\"'));",
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('tokenCliente', data.token);",
                  "if (data.refreshToken) pm.collectionVariables.set('refreshTokenCliente', data.refreshToken);",
                  "const payload = JSON.parse(atob(data.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.test('payload id/email/perfil', () => pm.expect(payload).to.include.keys('id', 'email', 'perfil'));",
                  "pm.test('expira em 30 minutos', () => pm.expect(payload.exp - payload.iat).to.eql(1800));",
                  "pm.test('tem refreshToken', () => pm.expect(data.refreshToken).to.be.a('string').that.is.not.empty);",
                  "pm.test('usuario {id,nome,email,perfil}', () => pm.expect(data.usuario).to.have.all.keys('id', 'nome', 'email', 'perfil'));"
                ]
              }
            }
          ],
