PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=get_order
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=
# Access JWT (default 30m). Use ex.: 1m em dev para testar refresh.
JWT_ACCESS_EXPIRES_IN=30m
# Refresh token opaco (default 7d). Formato: número + s|m|h|d.
JWT_REFRESH_EXPIRES_IN=7d
# Origens do CORS, separadas por vírgula. Obrigatório no boot: lista explícita, sem "*".
# Vazio ou "*" encerra o processo. frontend-cliente = 5173, frontend-gestao = 5174.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
# Rate limit geral em /api (defaults: 200 req / 15 min por IP).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Rate limit restrito em POST /auth/login, /auth/register e /auth/refresh (defaults: 20 / 15 min).
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
